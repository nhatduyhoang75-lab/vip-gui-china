-- Hàm tạo nút Boost
local function createBoostBtn(text, y)
    local btn = Instance.new("TextButton", Scroll)
    btn.Size = UDim2.new(0.9, 0, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    btn.Text = text
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(0, 200, 80)
    stroke.Thickness = 1

    btn.MouseButton1Click:Connect(function()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        local dur = 10 / (hum.WalkSpeed > 0 and hum.WalkSpeed or 16)
        hum.PlatformStand = true
        currentTween = TweenService:Create(hrp, TweenInfo.new(dur), {CFrame = hrp.CFrame + Vector3.new(0, y, 0)})
        currentTween:Play()
        currentTween.Completed:Wait()
        hum.PlatformStand = false
        if activeStates.AntiFall then lastHrpY = hrp.Position.Y end
    end)
end
createBoostBtn("Boost ⬆️ (+10 Y)", 10)
