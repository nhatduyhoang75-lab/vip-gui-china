-- Hàm tạo nút
local function createToggle(name, text, callback)
    local btn = Instance.new("TextButton", Scroll)
    btn.Size = UDim2.new(0.9, 0, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    btn.Text = text .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(255, 80, 80)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(function()
        activeStates[name] = not activeStates[name]
        btn.Text = text .. (activeStates[name] and ": ON" or ": OFF")
        btn.TextColor3 = activeStates[name] and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 80, 80)
        if callback then callback(activeStates[name]) end
    end)
end

-- Danh sách tính năng
createToggle("AntiKick", "Anti Kick")
createToggle("AntiFall", "Anti Fall", function(on)
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if on then
        bv = Instance.new("BodyVelocity", hrp)
        bv.MaxForce = Vector3.new(0, math.huge, 0)
        bv.Velocity = Vector3.new(0, 0, 0)
    elseif bv then bv:Destroy() end
end)
