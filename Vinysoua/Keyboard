-- [[ AUTO REFRESH KHI HỒI SINH ]]
local function setupCharacter(char)
    updateSlidePhysical(char, activeStates.AntiSlide)
    local hum = char:WaitForChild("Humanoid", 10)
    if hum then
        hum.StateChanged:Connect(function() 
            updateSlidePhysical(char, activeStates.AntiSlide) 
        end)
    end
end

if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(setupCharacter)

-- [[ VÒNG LẶP CHẠY NGẦM LOGIC (HEARTBEAT) ]]
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    
    -- Anti Fall V15
    if activeStates.AntiFall then
        if not bv or bv.Parent ~= hrp then
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(0, math.huge, 0)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = hrp
        end
    else
        if bv then bv:Destroy(); bv = nil end
    end
    
    -- LOGIC LOW GRAVITY: Khóa cứng trọng lực map bằng 5 khi bật
    if activeStates.LowGravity then
        workspace.Gravity = 5
    end
    
    -- LOGIC AUTO KEY THÔNG MINH
    if activeStates.AutoKey then
        for _, obj in pairs(workspace:GetDescendants()) do
            local nameLower = string.lower(obj.Name)
            if string.find(nameLower, "key") 
               and not string.find(nameLower, "keyboard") 
               and not string.find(nameLower, "keypad")
               and not string.find(nameLower, "keyhole")
               and not string.find(nameLower, "keybind") then
                
                local targetCFrame = nil
                if obj:IsA("BasePart") then
                    targetCFrame = obj.CFrame
                elseif obj:IsA("Model") or obj:IsA("Tool") then
                    if obj.PrimaryPart then
                        targetCFrame = obj.PrimaryPart.CFrame
                    else
                        local subPart = obj:FindFirstChildWhichIsA("BasePart", true)
                        if subPart then targetCFrame = subPart.CFrame end
                    end
                end
                
                if targetCFrame then
                    hrp.CFrame = targetCFrame + Vector3.new(0, 2, 0)
                    break 
                end
            end
        end
    end
    
    -- Xử lý tốc độ và đi xuyên tường
    if activeStates.WalkSpeedLoop then hum.WalkSpeed = speedValue end
    if activeStates.Noclip then
        for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
    end
    
    -- Các chế độ chạy nhanh nâng cao
    if activeStates.Cspeed and hum.MoveDirection.Magnitude > 0 then hrp.CFrame += (hum.MoveDirection * (speedValue / 30)) end
    if activeStates.TpWalk and hum.MoveDirection.Magnitude > 0 then hrp.CFrame += (hum.MoveDirection * (speedValue / 45)) end
end)

-- [[ BYPASS ANTI KICK TOÀN DIỆN ]]
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
local oldIndex = mt.__index
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if activeStates.AntiKick and (method == "Kick" or method == "kick") and self == LocalPlayer then return nil end
    return oldNamecall(self, ...)
end)

mt.__index = newcclosure(function(self, key)
    if activeStates.AntiKick and self == LocalPlayer and (key == "Kick" or key == "kick") then
        return newcclosure(function() return nil end)
    end
    return oldIndex(self, key)
end)
setreadonly(mt, true)
