-- [[ HÀM CẬP NHẬT VẬT LÝ MA SÁT CHO ANTI SLIDE ]]
local function updateSlidePhysical(char, forceApply)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local state = hum and hum:GetState()
    local m = (state == Enum.HumanoidStateType.Jumping or not forceApply) and 0.7 or 35
    for _, p in pairs(char:GetDescendants()) do 
        if p:IsA("BasePart") then p.CustomPhysicalProperties = PhysicalProperties.new(m, 0.3, 0.5) end 
    end
end

-- Hàm tạo các nút Toggle bật tắt liên tục
local function createToggle(name, text)
    local btn = Instance.new("TextButton", Scroll)
    btn.Size = UDim2.new(0.9, 0, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    btn.Text = text .. ": OFF"
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.TextColor3 = Color3.fromRGB(255, 80, 80)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        activeStates[name] = not activeStates[name]
        btn.Text = text .. (activeStates[name] and ": ON" or ": OFF")
        btn.TextColor3 = activeStates[name] and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 80, 80)
        
        if name == "AntiSlide" then
            updateSlidePhysical(LocalPlayer.Character, activeStates.AntiSlide)
        elseif name == "LowGravity" and not activeStates.LowGravity then
            -- Khi tắt ngang, trả lại trọng lực mặc định ngay lập tức cho đỡ trễ
            workspace.Gravity = 196.2
        end
    end)
end

