-- Nút Boost
local function createBoostBtn(text, y)
    local btn = Instance.new("TextButton", Scroll)
    btn.Size = UDim2.new(0.9, 0, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 150)
    btn.Text = text
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(function()
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then return end
        local dur = 10 / (hum.WalkSpeed > 0 and hum.WalkSpeed or 16)
        hum.PlatformStand = true
        currentTween = TweenService:Create(hrp, TweenInfo.new(dur), {CFrame = hrp.CFrame + Vector3.new(0, y, 0)})
        currentTween:Play()
        currentTween.Completed:Wait()
        hum.PlatformStand = false
    end)
end
createBoostBtn("Boost ⬆️ (+10 Y)", 10)
createBoostBtn("Boost ⬇️ (-10 Y)", -10)

-- Logic chung
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    
    if activeStates.WalkSpeedLoop then hum.WalkSpeed = speedValue end
    if activeStates.Noclip then
        for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
    end
    if activeStates.Cspeed and hum.MoveDirection.Magnitude > 0 then hrp.CFrame += (hum.MoveDirection * (speedValue / 30)) end
    if activeStates.TpWalk and hum.MoveDirection.Magnitude > 0 then hrp.CFrame += (hum.MoveDirection * (speedValue / 45)) end
end)

-- Anti Slide Logic
LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid").StateChanged:Connect(function(_, new)
        if not activeStates.AntiSlide then return end
        local m = (new == Enum.HumanoidStateType.Jumping) and 0.7 or 35
        for _, p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CustomPhysicalProperties = PhysicalProperties.new(m, 0.3, 0.5) end end
    end)
end)

MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    Scroll.Visible = not isMinimized
    MainFrame.Size = UDim2.new(0, 180, 0, isMinimized and 30 or 280)
    MinimizeBtn.Text = isMinimized and "+" or "-"
end)

-- Bypass Kick
local old; old = hookmetamethod(game, "__namecall", function(self, ...)
    if activeStates.AntiKick and getnamecallmethod():lower() == "kick" then return nil end
    return old(self, ...)
end)
